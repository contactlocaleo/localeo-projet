+@grouped_animation_router.get("/animations/{animation_id}/dossier", dependencies=[Depends(_require_feature)])
+def consulter_dossier_facturation_animation(
+    animation_id: UUID,
+    contexte=Depends(require_animation_permission(PermissionAnimation.LIRE)),
+):
+    with SqlAlchemyUnitOfWork() as uow:
+        return ServiceDossierFacturationAnimation(uow.session).consulter(
+            animation_id, contexte["partenaire"].id, contexte["session"].commune_active_id,
+        )
+
+
+@grouped_animation_router.post("/{demande_id}/relancer", dependencies=[Depends(_require_feature)])
+def relancer_demande_facturation_animation(
+    demande_id: UUID,
+    idempotency_key: str = Header(alias="Idempotency-Key", min_length=8, max_length=128),
+    contexte=Depends(require_animation_permission(PermissionAnimation.MODIFIER)),
+):
+    with SqlAlchemyUnitOfWork() as uow:
+        result = ServiceDossierFacturationAnimation(uow.session).relancer(
+            demande_id, contexte["partenaire"].id, contexte["session"].commune_active_id, idempotency_key,
+        )
+        uow.commit()
+        return result
