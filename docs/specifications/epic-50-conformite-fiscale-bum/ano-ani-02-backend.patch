+++ b/app/domaine/conformite_fiscale_bum/dossier_facturation_animation.py
@@ -0,0 +1,38 @@
+from datetime import timedelta
+
+from app.domaine.shared.exceptions.regle_metier_violee import RegleMetierViolee
+
+
+def synthese_facturation(droits, validations, demandes, *, lots_materialises):
+    """Count coverage of each expected right, never just existing requests."""
+    remplacees = {d["previous_id"] for d in demandes if d["status"] != "CANCELLED" and d["previous_id"]}
+    actives = [d for d in demandes if d["status"] != "CANCELLED" and d["id"] not in remplacees]
+    couvertes = set()
+    demandees = set()
+    for demande in actives:
+        demandees.update(demande["validations"])
+        if demande["status"] == "PROVIDED" and demande["document"] and demande["correction_type"] != "CREDIT_NOTE":
+            couvertes.update(demande["validations"])
+    attendus = set(droits)
+    executes = {droit for droit in attendus if droit in validations}
+    recus = {droit for droit in executes if validations[droit] in couvertes}
+    sans_demande = {droit for droit in executes if validations[droit] not in demandees}
+    return {
+        "expectedPrestations": len(attendus), "executedPrestations": len(executes),
+        "receivedPrestations": len(recus), "notExecutedPrestations": len(attendus - executes),
+        "missingRequests": len(sans_demande),
+        "pendingPrestations": len(executes - recus - sans_demande),
+        "lotsMaterialized": lots_materialises,
+        "complete": bool(attendus) and lots_materialises and recus == attendus,
+    }
+
+
+def prochaine_relance(created_at, last_reminded_at):
+    return (last_reminded_at or created_at) + timedelta(days=1)
+
+
+def verifier_relance(status, now, available_at, *, replaced=False):
+    if replaced or status not in {"REQUESTED", "ACKNOWLEDGED", "PROCESSING"}:
+        raise RegleMetierViolee("Cette demande ne peut pas etre relancee")
+    if now < available_at:
+        raise RegleMetierViolee("Une relance est possible au plus tot 24 heures apres le dernier envoi")
diff --git a/app/application/conformite_fiscale_bum/service_dossier_facturation_animation.py b/app/application/conformite_fiscale_bum/service_dossier_facturation_animation.py
