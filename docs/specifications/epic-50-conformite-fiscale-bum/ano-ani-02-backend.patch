--- /dev/null
+++ b/app/application/conformite_fiscale_bum/service_dossier_facturation_animation.py
@@ -0,0 +1,131 @@
+import hashlib
+from html import escape
+from uuid import UUID
+
+from sqlalchemy import select
+from sqlalchemy.orm import selectinload
+
+from app.application.conformite_fiscale_bum.service_demandes_facture_groupees import ServiceDemandesFactureGroupees
+from app.application.exploitation.services.service_preparation_email import ServicePreparationEmail
+from app.domaine.conformite_fiscale_bum.dossier_facturation_animation import (
+    prochaine_relance, synthese_facturation, verifier_relance,
+)
+from app.domaine.shared.exceptions.regle_metier_violee import RegleMetierViolee
+from app.domaine.shared.exceptions.ressource_domaine_introuvable import RessourceDomaineIntrouvable
+from app.infrastructure.persistence.epic50_models import DemandeFactureGroupeeOrm, LigneDemandeFactureGroupeeOrm
+from app.infrastructure.persistence.mappers import from_email_sortant
+from app.infrastructure.persistence.models import (
+    AchatCoffretOrm, AnimationOrm, CoffretInstanceOrm, CommandeAchatOrm,
+    CommercantOrm, EvenementAuditOrm, StatutPrestationCoffretInstanceOrm, ValidationPrestationOrm,
+)
+from app.utils.dates import utc_now_naive
+
+RELANCE = "ANIMATION_INVOICE_REQUEST_REMINDED"
+
+
+class ServiceDossierFacturationAnimation:
+    def __init__(self, session):
+        self.session = session
+        self.demandes = ServiceDemandesFactureGroupees(session)
+
+    def _animation(self, animation_id, partenaire_id, commune_id):
+        animation = self.session.execute(select(AnimationOrm).where(
+            AnimationOrm.id == UUID(str(animation_id)), AnimationOrm.partenaire_id == UUID(str(partenaire_id)),
+            AnimationOrm.commune_id == commune_id,
+        )).scalar_one_or_none()
+        if animation is None:
+            raise RessourceDomaineIntrouvable("Animation introuvable")
+        return animation
+
+    def _relances(self, request_id):
+        return self.session.execute(select(EvenementAuditOrm).where(
+            EvenementAuditOrm.action == RELANCE, EvenementAuditOrm.ressource_type == "demande_facture_groupee",
+            EvenementAuditOrm.ressource_id == str(request_id),
+        ).order_by(EvenementAuditOrm.date_evenement.desc())).scalars().all()
+
+    def _payload(self, row, replaced=False):
+        payload = self.demandes._payload(row)
+        merchant = self.session.get(CommercantOrm, row.commercant_id)
+        reminders = self._relances(row.id)
+        last = reminders[0].date_evenement if reminders else None
+        available = prochaine_relance(row.created_at, last)
+        payload.update({
+            "commandeId": str(row.commande_id),
+            "commercantNom": merchant.nom if merchant else "Commercant non renseigne",
+            "reminderCount": len(reminders), "lastRemindedAt": last,
+            "nextReminderAt": available,
+            "canRemind": not replaced and row.statut in {"REQUESTED", "ACKNOWLEDGED", "PROCESSING"}
+                and utc_now_naive() >= available and bool(merchant and merchant.contact_email),
+        })
+        return payload
+
+    def consulter(self, animation_id, partenaire_id, commune_id):
+        animation = self._animation(animation_id, partenaire_id, commune_id)
+        orders = self.session.execute(select(CommandeAchatOrm).where(
+            CommandeAchatOrm.contexte_type == "ANIMATION_LOTS", CommandeAchatOrm.contexte_id == animation.id,
+        ).options(selectinload(CommandeAchatOrm.lignes))).scalars().all()
+        order_ids = [order.id for order in orders]
+        rows = self.session.execute(self.demandes._requete_demandeur("ANIMATION_PARTNER", partenaire_id, commune_id)
+            .where(DemandeFactureGroupeeOrm.commande_id.in_(order_ids))
+            .order_by(DemandeFactureGroupeeOrm.created_at.desc())).scalars().all()
+        instances = self.session.execute(select(CoffretInstanceOrm).join(AchatCoffretOrm,
+            AchatCoffretOrm.id == CoffretInstanceOrm.achat_id).where(
+            AchatCoffretOrm.commande_achat_id.in_(order_ids),
+        )).scalars().all()
+        instance_ids = [instance.id for instance in instances]
+        rights = self.session.execute(select(StatutPrestationCoffretInstanceOrm).where(
+            StatutPrestationCoffretInstanceOrm.coffret_instance_id.in_(instance_ids),
+        )).scalars().all()
+        validations = self.session.execute(select(ValidationPrestationOrm).where(
+            ValidationPrestationOrm.coffret_instance_id.in_(instance_ids), ValidationPrestationOrm.annulee_at.is_(None),
+        )).scalars().all()
+        lines = self.session.execute(select(LigneDemandeFactureGroupeeOrm).where(
+            LigneDemandeFactureGroupeeOrm.demande_id.in_([row.id for row in rows]),
+        )).scalars().all()
+        expected_instances = sum(line.quantite for order in orders if order.paid_at for line in order.lignes)
+        materialized = expected_instances > 0 and len(instances) >= expected_instances
+        # A missing rights snapshot must not make a partially loaded lot complete.
+        materialized = materialized and set(instance_ids) <= {right.coffret_instance_id for right in rights}
+        summary = synthese_facturation(
+            {str(right.id) for right in rights},
+            {str(v.statut_prestation_coffret_instance_id): str(v.id) for v in validations},
+            [{"id": str(row.id), "status": row.statut, "previous_id": str(row.previous_request_id) if row.previous_request_id else None,
+              "document": bool(row.invoice_document_id), "correction_type": row.correction_type,
+              "validations": {str(line.validation_prestation_id) for line in lines if line.demande_id == row.id}} for row in rows],
+            lots_materialises=materialized,
+        )
+        replaced = {row.previous_request_id for row in rows if row.statut != "CANCELLED" and row.previous_request_id}
+        return {"animationId": str(animation.id), "animationNom": animation.nom, "summary": summary,
+                "requests": [self._payload(row, row.id in replaced) for row in rows]}
+
+    def relancer(self, request_id, partenaire_id, commune_id, key):
+        # Lock the same row used by merchant transitions, serializing concurrent reminders.
+        row = self.session.execute(self.demandes._requete_demandeur("ANIMATION_PARTNER", partenaire_id, commune_id)
+            .where(DemandeFactureGroupeeOrm.id == UUID(str(request_id)))
+            .with_for_update(of=DemandeFactureGroupeeOrm)).scalar_one_or_none()
+        if row is None:
+            raise RessourceDomaineIntrouvable("Demande groupee introuvable")
+        digest = hashlib.sha256(key.encode()).hexdigest()
+        reminders = self._relances(row.id)
+        if any(event.event_metadata.get("idempotencyHash") == digest for event in reminders):
+            return {"id": str(row.id), "idempotentReplay": True}
+        replaced = self.session.execute(select(DemandeFactureGroupeeOrm.id).where(
+            DemandeFactureGroupeeOrm.previous_request_id == row.id, DemandeFactureGroupeeOrm.statut != "CANCELLED",
+        )).first() is not None
+        now = utc_now_naive()
+        verifier_relance(row.statut, now, prochaine_relance(row.created_at,
+            reminders[0].date_evenement if reminders else None), replaced=replaced)
+        merchant = self.session.get(CommercantOrm, row.commercant_id)
+        if merchant is None or not merchant.contact_email:
+            raise RegleMetierViolee("Le commercant ne dispose pas d'une adresse email de contact")
+        message = f"La facture de la demande {row.reference} est toujours attendue. Consultez votre espace Localeo Finance."
+        email = ServicePreparationEmail().preparer_email(
+            merchant.contact_email, f"Relance de la demande {row.reference}", f"<p>{escape(message)}</p>", message,
+            "RELANCE_DEMANDE_FACTURE_GROUPEE", correlation_id=str(row.id),
+            source_type="RELANCE_DEMANDE_FACTURE_GROUPEE", source_id=f"{row.id}:{digest}",
+        )
+        self.session.add(from_email_sortant(email))
+        self.session.add(EvenementAuditOrm(action=RELANCE, phase="success", date_evenement=now,
+            acteur=f"partenaire-animation:{partenaire_id}", commercant_id=row.commercant_id,
+            ressource_type="demande_facture_groupee", ressource_id=str(row.id), event_metadata={"idempotencyHash": digest}))
+        return {"id": str(row.id), "idempotentReplay": False, "nextReminderAt": prochaine_relance(row.created_at, now)}
diff --git a/tests/security/test_animation_invoice_dossier.py b/tests/security/test_animation_invoice_dossier.py
