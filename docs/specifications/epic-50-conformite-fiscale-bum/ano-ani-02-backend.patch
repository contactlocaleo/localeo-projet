+++ b/tests/security/test_animation_invoice_dossier.py
@@ -0,0 +1,108 @@
+from datetime import datetime, timedelta
+from types import SimpleNamespace
+from uuid import UUID
+
+import pytest
+
+from app.domaine.conformite_fiscale_bum.dossier_facturation_animation import (
+    prochaine_relance, synthese_facturation, verifier_relance,
+)
+from app.domaine.shared.exceptions.regle_metier_violee import RegleMetierViolee
+
+
+def demande(id="request", status="PROVIDED", **kwargs):
+    return {"id": id, "status": status, "previous_id": None, "document": True,
+            "correction_type": None, "validations": {"v1"}, **kwargs}
+
+
+def test_complete_requires_all_expected_prestations_not_only_existing_requests():
+    summary = synthese_facturation({"right1", "right2"}, {"right1": "v1"}, [demande()], lots_materialises=True)
+    assert summary["complete"] is False
+    assert summary["receivedPrestations"] == 1
+    assert summary["notExecutedPrestations"] == 1
+    summary = synthese_facturation({"right1", "right2"}, {"right1": "v1", "right2": "v2"}, [demande()], lots_materialises=True)
+    assert summary["complete"] is False
+    assert summary["missingRequests"] == 1
+
+
+@pytest.mark.parametrize("rows,materialized", [([], True), ([demande()], False), ([demande(status="PROCESSING")], True),
+    ([demande(document=False)], True), ([demande(status="CANCELLED")], True),
+    ([demande(correction_type="CREDIT_NOTE")], True)])
+def test_unconfirmed_missing_cancelled_or_credited_documents_never_complete(rows, materialized):
+    assert not synthese_facturation({"r"}, {"r": "v1"}, rows, lots_materialises=materialized)["complete"]
+
+
+def test_all_documents_complete_and_corrections_supersede_original():
+    original = demande()
+    assert synthese_facturation({"r"}, {"r": "v1"}, [original], lots_materialises=True)["complete"]
+    correction = demande("correction", "PROCESSING", previous_id="request")
+    assert not synthese_facturation({"r"}, {"r": "v1"}, [original, correction], lots_materialises=True)["complete"]
+    correction["status"] = "PROVIDED"
+    assert synthese_facturation({"r"}, {"r": "v1"}, [original, correction], lots_materialises=True)["complete"]
+    assert not synthese_facturation(set(), {}, [], lots_materialises=True)["complete"]
+
+
+def test_reminders_are_limited_to_pending_requests_after_24_hours():
+    now = datetime(2026, 9, 7, 12)
+    available = prochaine_relance(now, None)
+    assert available == now + timedelta(days=1)
+    with pytest.raises(RegleMetierViolee):
+        verifier_relance("REQUESTED", now, available)
+    verifier_relance("REQUESTED", available, available)
+    for status in ("PROVIDED", "CANCELLED", "UNKNOWN"):
+        with pytest.raises(RegleMetierViolee):
+            verifier_relance(status, available, available)
+    with pytest.raises(RegleMetierViolee):
+        verifier_relance("PROCESSING", available, available, replaced=True)
+
+
+def test_service_does_not_serialize_an_animation_from_another_commune():
+    from app.application.conformite_fiscale_bum.service_dossier_facturation_animation import ServiceDossierFacturationAnimation
+    from app.domaine.shared.exceptions.ressource_domaine_introuvable import RessourceDomaineIntrouvable
+    class Session:
+        def execute(self, query):
+            params = query.compile().params
+            assert all(UUID(int=i) in params.values() for i in (1, 2, 3))
+            return SimpleNamespace(scalar_one_or_none=lambda: None)
+    with pytest.raises(RessourceDomaineIntrouvable):
+        ServiceDossierFacturationAnimation(Session()).consulter(UUID(int=1), UUID(int=2), UUID(int=3))
+
+
+def test_reminder_replay_locks_and_checks_partner_and_commune_without_new_email():
+    import hashlib
+    from app.application.conformite_fiscale_bum.service_dossier_facturation_animation import ServiceDossierFacturationAnimation
+    key = "replay-key"
+    class Session:
+        def execute(self, query):
+            compiled = query.compile()
+            assert all(UUID(int=i) in compiled.params.values() or str(UUID(int=i)) in compiled.params.values() for i in (1, 2, 3))
+            assert "FOR UPDATE" in str(compiled)
+            return SimpleNamespace(scalar_one_or_none=lambda: SimpleNamespace(id=UUID(int=1)))
+        def add(self, row):
+            pytest.fail("Replay must not enqueue another email")
+    service = ServiceDossierFacturationAnimation(Session())
+    service._relances = lambda id: [SimpleNamespace(event_metadata={"idempotencyHash": hashlib.sha256(key.encode()).hexdigest()})]
+    assert service.relancer(UUID(int=1), UUID(int=2), UUID(int=3), key)["idempotentReplay"] is True
+
+
+def test_successful_reminder_enqueues_email_and_audit_in_the_same_session(monkeypatch):
+    import app.application.conformite_fiscale_bum.service_dossier_facturation_animation as module
+    row = SimpleNamespace(id=UUID(int=1), commercant_id=UUID(int=4), reference="DFG-1", statut="REQUESTED", created_at=datetime(2020, 1, 1))
+    added = []
+    class Session:
+        def execute(self, query):
+            return SimpleNamespace(scalar_one_or_none=lambda: row, first=lambda: None)
+        def get(self, model, id):
+            return SimpleNamespace(contact_email="merchant@example.test")
+        def add(self, value):
+            added.append(value)
+    email = SimpleNamespace(kind="email")
+    monkeypatch.setattr(module, "ServicePreparationEmail", lambda: SimpleNamespace(preparer_email=lambda *args, **kwargs: email))
+    monkeypatch.setattr(module, "from_email_sortant", lambda value: value)
+    service = module.ServiceDossierFacturationAnimation(Session())
+    service._relances = lambda id: []
+    result = service.relancer(UUID(int=1), UUID(int=2), UUID(int=3), "new-reminder-key")
+    assert result["idempotentReplay"] is False
+    assert added[0] is email
+    assert added[1].action == module.RELANCE
+    assert len(added) == 2
