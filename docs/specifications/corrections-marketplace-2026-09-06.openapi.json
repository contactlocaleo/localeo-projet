  "components": {
    "schemas": {
      "PaiementInitialisationRequest": {
        "properties": {
          "coffret_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Coffret Id"
          },
          "email_client": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email Client"
          },
          "telephone_client": {
            "type": "string",
            "maxLength": 40,
            "minLength": 6,
            "title": "Telephone Client"
          },
          "type_client": {
            "type": "string",
            "enum": [
              "PARTICULIER",
              "PROFESSIONNEL"
            ],
            "title": "Type Client",
            "default": "PARTICULIER"
          },
          "quantite": {
            "type": "integer",
            "maximum": 1000,
            "minimum": 1,
            "title": "Quantite",
            "default": 1
          },
          "nom_entreprise": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Nom Entreprise"
          },
          "nom_contact": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Nom Contact"
          },
          "siret": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 14
              },
              {
                "type": "null"
              }
            ],
            "title": "Siret"
          },
          "credit_terms_accepted": {
            "type": "boolean",
            "title": "Credit Terms Accepted",
            "default": false
          },
          "credit_terms_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit Terms Version"
          },
          "localeo_live_installation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Localeo Live Installation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coffret_id",
          "email_client",
          "telephone_client"
        ],
        "title": "PaiementInitialisationRequest"
      },
      "PaiementInitialisationResponse": {
        "properties": {
          "payment_return_supported": {
            "type": "boolean",
            "title": "Payment Return Supported",
            "default": true
          },
          "achat_id": {
            "type": "string",
            "title": "Achat Id",
            "description": "Identifiant de l'achat créé avant redirection vers le paiement."
          },
          "checkout_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkout Url",
            "description": "URL de checkout Stripe, absente si le credit couvre la totalite."
          },
          "type_client": {
            "type": "string",
            "title": "Type Client",
            "description": "Type de client retenu pour l'achat."
          },
          "quantite": {
            "type": "integer",
            "title": "Quantite",
            "description": "Nombre de coffrets commandés."
          },
          "nom_entreprise": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nom Entreprise",
            "description": "Nom de l'entreprise acheteuse pour un achat professionnel."
          },
          "nom_contact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nom Contact",
            "description": "Nom du contact acheteur pour un achat professionnel."
          },
          "idempotent_replay": {
            "type": "boolean",
            "title": "Idempotent Replay",
            "description": "Indique si la réponse réutilise une initialisation déjà créée avec la même clé d'idempotence.",
            "default": false
          },
          "credit_applique_centimes": {
            "type": "integer",
            "title": "Credit Applique Centimes",
            "description": "Part du total reservee sur le credit d'achat B2B.",
            "default": 0
          },
          "montant_stripe_centimes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Montant Stripe Centimes",
            "description": "Part restant a regler par Stripe."
          }
        },
        "type": "object",
        "required": [
          "achat_id",
          "type_client",
          "quantite"
        ],
        "title": "PaiementInitialisationResponse"
      },
      "ApiErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ],
            "title": "Detail"
          },
          "correlationId": {
            "type": "string",
            "title": "Correlationid",
            "description": "Reference d'erreur canonique a communiquer au support."
          },
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "deprecated": true,
            "description": "Alias deprecie de correlationId."
          }
        },
        "type": "object",
        "required": [
          "detail",
          "correlationId",
          "request_id"
        ],
        "title": "ApiErrorResponse"
      },
      "PaiementRetourResponse": {
        "properties": {
          "achat_id": {
            "type": "string",
            "title": "Achat Id"
          },
          "statut_achat": {
            "type": "string",
            "title": "Statut Achat"
          },
          "type_client": {
            "type": "string",
            "title": "Type Client"
          },
          "quantite": {
            "type": "integer",
            "title": "Quantite"
          },
          "coffret_nom": {
            "type": "string",
            "title": "Coffret Nom"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "achat_id",
          "statut_achat",
          "type_client",
          "quantite",
          "coffret_nom"
        ],
        "title": "PaiementRetourResponse"
      },
      "QrTokenDetailPayload": {
        "properties": {
          "coffret_instance_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coffret Instance Id",
            "description": "Identifiant de l'instance de coffret associee au QR."
          },
          "verification_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Code",
            "description": "Code court de verification de l'instance associee."
          },
          "qr_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Token",
            "description": "Jeton QR transmis en entree."
          },
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload",
            "description": "Payload metier decode depuis le token quand il est lisible."
          },
          "kid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kid",
            "description": "Identifiant de cle ayant servi a signer le QR, si disponible."
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type",
            "description": "Type metier du QR (`achat_coffret`, etc.)."
          },
          "validite": {
            "type": "string",
            "title": "Validite",
            "description": "Etat de validite du QR (`ABSENT`, `VALIDE`, `EXPIRE`, `INVALIDE`, `NON_VERIFIE`)."
          },
          "validite_detail": {
            "type": "string",
            "title": "Validite Detail",
            "description": "Detail lisible expliquant le statut de validite."
          },
          "image_svg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Svg",
            "description": "Representation SVG du QR code, directement affichable en HTML."
          }
        },
        "type": "object",
        "required": [
          "validite",
          "validite_detail"
