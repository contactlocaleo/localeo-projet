{
  "description": "Contexte de workspace Localeo au démarrage et après compaction ; lecture seule, sans réseau.",
  "hooks": {
    "SessionStart": [{
      "matcher": "^(startup|resume|clear|compact)$",
      "hooks": [{
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex_context.cjs\"",
        "commandWindows": "node -e \"require(require('node:path').join(require('node:child_process').execFileSync('git', ['rev-parse','--show-toplevel'], {encoding:'utf8',timeout:1500,windowsHide:true}).trim(), 'scripts/codex_context.cjs')).run()\"",
        "timeout": 10,
        "statusMessage": "Repérage des dépôts Localeo",
        "additionalContextLimit": 1800
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex_finish.cjs\"",
        "commandWindows": "node -e \"require(require('node:path').join(require('node:child_process').execFileSync('git', ['rev-parse','--show-toplevel'], {encoding:'utf8',timeout:1500,windowsHide:true}).trim(), 'scripts/codex_finish.cjs')).run()\"",
        "timeout": 10,
        "statusMessage": "Rappel des preuves Localeo"
      }]
    }]
  }
}
